# Target & CPU
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# Flash & Partitions (16MB Flash for N16)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Optimised for speed; without this a build is made for debugging
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM (8MB Octal PSRAM for R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
# Wi-Fi and TCP/IP buffers come from PSRAM first, leaving internal RAM for tasks. The fixed receive
# buffers stay at 10 (the default would rise to 16, all of them in internal RAM).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10

# TLS buffers in PSRAM (several encrypted IRC networks at once)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# FreeRTOS & Tasks
CONFIG_FREERTOS_HZ=1000
# CPU load on the home page
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Networking & Sockets
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_TCP_MSS=1436
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_WND_DEFAULT=5744

# Web Server Limits
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# IRC over TLS: lets "ssl_verify": false accept self-signed servers.
# Only applies when no verification option is set; OTA downloads always verify.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# Hardware Acceleration
CONFIG_MBEDTLS_HARDWARE_SHA=y
